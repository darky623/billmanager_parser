# Cloudsell API
CLOUDSELL_API_URL=http://backend-api:8000
CLOUDSELL_SERVICE_KEY=your-secret-service-key

# Providers (list via nested env vars)
# Provider 0
PROVIDERS__0__PROVIDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROVIDERS__0__BASE_URL=https://billing.firstbyte.ru
PROVIDERS__0__USERNAME=your_user
PROVIDERS__0__PASSWORD=your_password
PROVIDERS__0__NAME_PREFIX=FB
# PROVIDERS__0__SERVER_TYPES=virtual
# PROVIDERS__0__FACTOR=1.3  # optional, default 1.3

# Provider 1
PROVIDERS__1__PROVIDER_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
PROVIDERS__1__BASE_URL=https://vps.datacheap.ru
PROVIDERS__1__USERNAME=your_user
PROVIDERS__1__PASSWORD=your_password
PROVIDERS__1__NAME_PREFIX=DC
# Enable after verifying dedicated order parameters and one-time setup fees:
# PROVIDERS__1__SERVER_TYPES=virtual,dedicated
# PROVIDERS__1__FACTOR=1.3  # optional, default 1.3

# Scheduler
PARSE_CRON=0 2 * * *

# Storage
SNAPSHOT_DIR=snapshots

# Timeouts (seconds)
PROVIDER_TIMEOUT=60.0
API_TIMEOUT=600.0
